	RunService.RenderStepped:Connect(function(dt)
		-- FOV draw (Desync.fun style)
		-- FOV only while Silent Aim / Aimbot is enabled
		updateFOV(sFOV, silentFOVCfg, (SA.Enabled == true) and (SA.ShowFOV == true), SA.Radius, dt)
		updateFOV(aFOV, aimbotFOVCfg, (AB.Enabled == true) and (AB.ShowFOV == true), AB.Radius, dt)

		-- Silent target cache
		if SA.Enabled then
			SA.Target = closestInFOV(SA.Radius or 150, SA.ClosestPart)
		else
			SA.Target = nil
		end

		-- Aimbot (Desync.fun style smooth lock)
		if AB.Enabled and (AB.Holding or AB.Manipulation) then
			local part = closestInFOV(AB.Radius or 200, AB.ClosestPart)
			AB.Target = part
			if part then
				local cam = workspace.CurrentCamera
				if cam then
					local smooth = math.clamp(tonumber(AB.Smoothing) or 0.25, 0.05, 1)
					local goal = CFrame.lookAt(cam.CFrame.Position, part.Position)
					cam.CFrame = cam.CFrame:Lerp(goal, smooth)
				end
			end
		else
			AB.Target = nil
		end
	end)
end


