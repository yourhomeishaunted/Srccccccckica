		local function updateDeflection()
			if not FighterController or not FighterController.Objects then return end
			for _, fighterObj in FighterController.Objects do
				local player = fighterObj.Player
				if not player then continue end
				if not fighterObj.Entity or not fighterObj.Entity:IsAlive() or fighterObj:Get("IsSpectating") then
					deflecting[player] = false
					continue
				end
				local equipped = fighterObj.EquippedItem
				local isKatana = equipped and equipped.ViewModel and equipped.ViewModel.Name == "Katana"
				deflecting[player] = isKatana and equipped._attack_cooldown and equipped._attack_cooldown > tick()
			end
		end

		local function isEnemy(player)
			if not player or player == lplr then return false end
			local okD, result = pcall(function()
				local duel = SpectateController and SpectateController.CurrentDuelSubject
				if duel and type(duel.GetDueler) == "function" then
					local localDueler = duel:GetDueler(lplr)
					local localTeam = localDueler and localDueler:Get("TeamID") or nil
					if localTeam and duel.Duelers then
						for _, dueler in duel.Duelers do
							if dueler.Player == player then
								return dueler:Get("TeamID") ~= localTeam
							end
						end
						return false
					end
				end
				local pTeam, lTeam = player:GetAttribute("TeamID"), lplr:GetAttribute("TeamID")
				if pTeam ~= nil and lTeam ~= nil then return pTeam ~= lTeam end
				if player.Team and lplr.Team then return player.Team ~= lplr.Team end
				return true
			end)
			return okD and result == true
		end

		local function isInvincible(plr)
			-- Force field / spawn protection — ALL modes (Gun, Knife, Melee)
			if not plr or not plr.Character then return false end
			local ch = plr.Character
			if ch:FindFirstChildOfClass("ForceField") then return true end
			if ch:FindFirstChild("ForceField") then return true end
			for _, d in ipairs(ch:GetDescendants()) do
				if d:IsA("ForceField") then return true end
			end
			local okAttr, invAttr = pcall(function()
				return plr:GetAttribute("IsInvincible") or plr:GetAttribute("Invincible")
					or ch:GetAttribute("IsInvincible") or ch:GetAttribute("Invincible")
			end)
			if okAttr and invAttr then return true end
			local okI, inv = pcall(function()
				if not FighterController or not FighterController.Objects then return false end
				for _, fo in FighterController.Objects do
					if fo.Player == plr and fo.Entity then
						local data
						pcall(function()
							if type(fo.Entity.Get) == "function" then
								data = fo.Entity:Get("Data")
							end
						end)
						if type(data) == "table" and (data.IsInvincible == true or data.Invincible == true) then
							return true
						end
						local ok2, v = pcall(function() return fo.Entity:Get("IsInvincible") end)
						if ok2 and v == true then return true end
						local ok3, v3 = pcall(function() return fo.Entity:Get("Invincible") end)
						if ok3 and v3 == true then return true end
					end
				end
				return false
			end)
			return okI and inv == true
		end

		local function getClosestTarget()
			local char = lplr.Character
			if not char then return nil, nil, nil end
			local myRoot = char:FindFirstChild("HumanoidRootPart")
			if not myRoot then return nil, nil, nil end
			local bestP, bestR, bestH, bestD = nil, nil, nil, 1e9
			for _, player in ipairs(plrs:GetPlayers()) do
				if not isEnemy(player) then continue end
				local pChar = player.Character
				if not pChar then continue end
				local pRoot = pChar:FindFirstChild("HumanoidRootPart")
				local pHead = pChar:FindFirstChild("HitboxHead")
					or pChar:FindFirstChild("HitboxHeadSmall")
					or pChar:FindFirstChild("PhysicalHitboxHead")
					or pChar:FindFirstChild("Head")
				local pHum = pChar:FindFirstChildWhichIsA("Humanoid")
				if not (pRoot and pHead and pHum and pHum.Health > 0) then continue end
				local d = (myRoot.Position - pRoot.Position).Magnitude
				if d < bestD then
					bestD, bestP, bestR, bestH = d, player, pRoot, pHead
				end
			end
			return bestP, bestR, bestH
		end

