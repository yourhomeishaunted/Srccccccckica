			local o = (getgenv().Options and getgenv().Options.MenuKeybind)
				or (Library and Library.Options and Library.Options.MenuKeybind)
				or (Library and Library.ToggleKeybind)
			if not o then return end
			local v = o.Value
			local key = input.KeyCode
			if typeof(v) == "EnumItem" and key == v then
				doToggle()
			elseif type(v) == "string" and Enum.KeyCode[v] and key == Enum.KeyCode[v] then
				doToggle()
			end
		end)
	end)
end)

