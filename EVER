						local mf = g:FindFirstChild("MainFrame", true) or g:FindFirstChild("Outer", true)
						if mf and mf:IsA("Frame") and mf.Size.X.Offset >= 300 then
							frame = mf
							break
						end
					end
				end
			end
			if frame then
