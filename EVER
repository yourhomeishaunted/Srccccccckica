	end)
	lockBtn.MouseButton1Click:Connect(function() end) -- absorb

	-- Live accent (Linoria registry style)
	task.spawn(function()
		while ScreenGui.Parent do
			local a, m = accent(), mainCol()
			for _, inner in ipairs({ toggleInner, lockInner }) do
				pcall(function()
					inner.BackgroundColor3 = m
