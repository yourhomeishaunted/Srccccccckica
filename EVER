	addAimUI(AimBox:AddTab("Silent Aim"), "SA", SA, false)
	addAimUI(AimBox:AddTab("Aimbot"), "AB", AB, true)

	-- Silent aim hook (Desync-style packet rewrite)
	task.defer(function()
		pcall(function()
			local repS = game:GetService("ReplicatedStorage")
			local remote = repS:WaitForChild("Remotes"):WaitForChild("Replication"):WaitForChild("Fighter"):WaitForChild("UseItem")
			if not hookmetamethod then return end
			local old
			old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local method = getnamecallmethod()
				if SA.Enabled and not (getgenv().Config and getgenv().Config.Enabled)
					and self == remote and method == "FireServer" then
					local args = {...}
					if math.random(1, 100) <= (SA.HitChance or 100) then
						local part = SA.Target or closestInFOV(SA.Radius or 150, SA.ClosestPart)
						if part then
							pcall(function()
								local util = require(repS.Modules.Utility)
								local targetPos = part.Position
								local shootFrom = workspace.CurrentCamera.CFrame.Position
								if SA.Manipulation then
									shootFrom = targetPos - Vector3.new(0, 5, 0)
								end
								local aimCF = CFrame.lookAt(shootFrom, targetPos)
								args[3] = {
									[utf8.char(1)] = {
										[utf8.char(0)] = util:EncodeCFrame(aimCF),
										[utf8.char(1)] = util:EncodeCFrame(part.CFrame),
										[utf8.char(2)] = part,
										[utf8.char(3)] = util:EncodeCFrame(CFrame.new(0,0,0)),
									}
								}
								if SA.Manipulation then args[4] = true end
							end)
						end
					end
					return old(self, table.unpack(args))
				end
				return old(self, ...)
			end))
		end)
	end)

