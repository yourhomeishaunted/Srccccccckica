local function getRageWeaponSlot()
	local cfg = getgenv().Config or {}
	local s = tostring(cfg.PreferredWeapon or cfg.WeaponSlot or "Primary")
	if s == "Secondary" then return "Secondary" end
	if s == "Melee" then return "Melee" end
	return "Primary"
end


-- In-game HUD names by weapon:
-- Primary:   ragebot: void…
-- Secondary: ragebot: void @username
-- Melee:     ragebot: melee void…
local function formatRageHud(kind, username)
	local cfg = getgenv().Config or {}
	local slot = getRageWeaponSlot()
	local name = username and tostring(username) or ""
	if kind == "idle" or not name or name == "" then
		if slot == "Melee" then return "ragebot: attacking" end
		if slot == "Secondary" then return "ragebot: firing" end
		return "ragebot: hitting"
	end
	if slot == "Melee" or kind == "melee" then
		return "ragebot: attacking " .. name
	elseif slot == "Secondary" or kind == "secondary" then
		return "ragebot: firing " .. name
	else
		return "ragebot: hitting " .. name
	end
end



