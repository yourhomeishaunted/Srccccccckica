	local SA, AB = getgenv().SilentAim, getgenv().Aimbot

	local function isEnemy(plr)
		if not plr or plr == LP then return false end
		if not SA.TeamCheck then return true end
		local myT = LP:GetAttribute("TeamID") or (LP.Team and LP.Team.Name)
		local theirT = plr:GetAttribute("TeamID") or (plr.Team and plr.Team.Name)
		if myT and theirT and myT == theirT then
			local distinct = {}
			for _, p in ipairs(Players:GetPlayers()) do
				local id = p:GetAttribute("TeamID") or (p.Team and p.Team.Name) or "x"
				distinct[id] = true
			end
			local n = 0
			for _ in pairs(distinct) do n = n + 1 end
			if n > 1 then return false end
		end
		return true
	end

	local function getPart(char, preferClosest)
		if not char then return nil end
		if preferClosest then
			return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
		end
		return char:FindFirstChild("Head")
			or char:FindFirstChild("HitboxHead")
			or char:FindFirstChild("HumanoidRootPart")
	end

	local function closestInFOV(radius, preferClosest)
		local cam = workspace.CurrentCamera
		if not cam then return nil end
		local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
		local best, bestD = nil, radius
		for _, plr in ipairs(Players:GetPlayers()) do
			if isEnemy(plr) and plr.Character then
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					local part = getPart(plr.Character, preferClosest)
					if part then
						local pos, on = cam:WorldToViewportPoint(part.Position)
						if on and pos.Z > 0 then
							local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
							if d <= radius and d < bestD then
								bestD, best = d, part
							end
						end
					end
				end
			end
		end
		return best
	end

	local function updateFOV(fovObj, cfg, show, radius, dt)
		dt = dt or 0.016
		if not show then
			fovObj.container.Visible = false
			return
		end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local r = math.max(tonumber(radius) or 100, 10)
		fovObj.container.Visible = true
		fovObj.container.Size = UDim2.fromOffset(r * 2, r * 2)
		fovObj.container.Position = UDim2.fromOffset(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
		fovObj.fill.Visible = cfg.FilledEnabled == true
		fovObj.fill.BackgroundTransparency = cfg.FilledTransparency or 0.7

		-- Animated spin (outline + fill)
		if cfg.SpinOn then
			local spd = tonumber(cfg.SpinSpd) or 40
			cfg.OutlineRotation = (cfg.OutlineRotation or 0) + spd * dt
			fovObj.strokegrad.Rotation = cfg.OutlineRotation % 360
		end
		if cfg.FilledAnimated or cfg.SpinOn then
			local fspd = (tonumber(cfg.FilledSpeed) or 1.5) * 60
			cfg.FilledRotation = (cfg.FilledRotation or 0) + fspd * dt
			fovObj.fillgrad.Rotation = cfg.FilledRotation % 360
		end

		-- Rainbow cycle (optional)
		local c1, c2, c3 = cfg.OutlineColor1, cfg.OutlineColor2, cfg.OutlineColor3 or cfg.OutlineColor1
		if cfg.Rainbow then
			cfg._hue = (cfg._hue or 0) + dt * 0.25
			if cfg._hue > 1 then cfg._hue = cfg._hue - 1 end
			c1 = Color3.fromHSV(cfg._hue, 0.9, 1)
			c2 = Color3.fromHSV((cfg._hue + 0.33) % 1, 0.9, 1)
			c3 = Color3.fromHSV((cfg._hue + 0.66) % 1, 0.9, 1)
		end
		fovObj.strokegrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, c1),
			ColorSequenceKeypoint.new(0.5, c2),
			ColorSequenceKeypoint.new(1, c3),
		})
		-- Animated fill gradient colors
		local f1 = cfg.FilledColor1 or Color3.new(1,1,1)
		local f2 = cfg.FilledColor2 or Color3.new(0,0,0)
		local f3 = cfg.FilledColor3 or f1
		if cfg.FilledAnimated and cfg.Rainbow then
			f1, f2, f3 = c1, c2, c3
		end
		fovObj.fillgrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, f1),
			ColorSequenceKeypoint.new(0.5, f3),
			ColorSequenceKeypoint.new(1, f2),
		})
	end

	-- UI
	local okAim, aimBox = pcall(function() return Tabs.Main:AddTabbox({ Side = 1 }) end)
