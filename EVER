			animator.Parent = hum
		end
		local id = resolveId()
		if not id then return end
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(id)
		local ok, tr = pcall(function() return animator:LoadAnimation(anim) end)
		anim:Destroy()
		if not ok or not tr then return end
		track = tr
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = true
		pcall(function() track:Play() end)
		pcall(function() track:AdjustSpeed(tonumber(ap.Speed) or 1) end)
		loopConn = RunService.RenderStepped:Connect(function()
			if not getgenv().AnimPlayer.Enabled then stopAnim() return end
			if track and track.IsPlaying == false then
				pcall(function() track:Play() end)
			end
		end)
	end

	LP.CharacterAdded:Connect(function()
		task.wait(0.5)
		if getgenv().AnimPlayer.Enabled then applyAnim() end
	end)

	local CharTab = Tabs and Tabs.Character
	if CharTab then
		local box = CharTab:AddLeftGroupbox("Animation Player") or CharTab:AddRightGroupbox("Animation Player")
		if not box and CharTab.AddGroupbox then
			box = CharTab:AddGroupbox("Animation Player")
		end
		-- EZ style groupboxes
		if not box then
			pcall(function()
				box = CharTab:AddLeftGroupbox("Animation Player")
			end)
		end
		if box then
			box:AddToggle("AnimPlayerEnabled", {
				Text = "Enable Animation Player",
				Default = false,
				Callback = function(v)
					getgenv().AnimPlayer.Enabled = v
					if v then applyAnim() else stopAnim() end
				end,
			})
			box:AddDropdown("AnimPlayerAnim", {
				Text = "Animation",
				Values = AnimNames,
				Default = 1, -- Solar System
				Callback = function(v)
					getgenv().AnimPlayer.Animation = v
					if getgenv().AnimPlayer.Enabled then applyAnim() end
				end,
			})
			box:AddInput("AnimPlayerCustomId", {
				Text = "Custom Animation ID",
				Default = "",
				Placeholder = "rbxassetid or numbers",
				Callback = function(v)
					getgenv().AnimPlayer.CustomId = tostring(v or "")
					if getgenv().AnimPlayer.Enabled then applyAnim() end
				end,
			})
			box:AddSlider("AnimPlayerSpeed", {
				Text = "Speed",
				Min = 0.1,
				Max = 5,
				Default = 1,
				Rounding = 1,
				Callback = function(v)
					getgenv().AnimPlayer.Speed = v
					if track then pcall(function() track:AdjustSpeed(v) end) end
				end,
			})
		end
	end
end
