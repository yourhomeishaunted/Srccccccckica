							end
						end
						if next(r) then equipMap[w] = r end
					end
				end
			end
		end)
		pcall(function()
			if type(getgenv().NemesisFinisherNames) == "table" then
				for w, n in pairs(getgenv().NemesisFinisherNames) do
					if type(w) == "string" and type(n) == "string" then fcMap[w] = n end
				end
			end
		end)

		-- if live equip table has data but names empty, parse live
		pcall(function()
			local eq = getgenv().NemesisEquipTable
			if type(eq) == "table" then
				for weapon, slots in pairs(eq) do
					if type(weapon) == "string" and type(slots) == "table" then
						equipMap[weapon] = equipMap[weapon] or {}
						for ctype, cos in pairs(slots) do
							local name = nil
							if type(cos) == "string" then name = cos
							elseif type(cos) == "table" then name = cos.Name or cos.DisplayName end
							if type(name) == "string" and name ~= "" then
								equipMap[weapon][ctype] = name
							end
						end
						if not next(equipMap[weapon]) then equipMap[weapon] = nil end
					end
				end
			end
		end)

		local data = {
			equip = equipMap,
			fcache = fcMap,
			_savedAt = os.time(),
			_ver = 2,
		}
		-- keep previous weapons if new map empty (don't wipe)
		if not next(equipMap) then
			pcall(function()
				for _, p in ipairs(PATHS) do
					local raw = tryRead(p)
					if raw then
						local ok, prev = pcall(function() return HttpService:JSONDecode(raw) end)
						if ok and type(prev) == "table" and type(prev.equip) == "table" and next(prev.equip) then
							data.equip = prev.equip
							data.fcache = type(prev.fcache) == "table" and prev.fcache or fcMap
							break
						end
					end
				end
			end)
		end

		getgenv().NemesisSkinConfig = data
		getgenv().NemesisEquipNames = data.equip
		getgenv().NemesisFinisherNames = data.fcache
		getgenv().LionSkinState = data
		getgenv().NemesisCosmeticMirror = data

		local cfgName = sanitizeConfigName(getgenv().__NemesisActiveConfigName or "default")
		data.configName = cfgName
		local payload = HttpService:JSONEncode(data)
		local wrote = false
		-- per-config file (this is what Load uses)
		pcall(function()
			if tryWrite(skinPathForConfig(cfgName), payload) then wrote = true end
		end)
		-- global fallback paths
		for _, p in ipairs(PATHS) do
			if tryWrite(p, payload) then
				wrote = true
			end
		end
		getgenv().__NemesisSkinsForever = data
		getgenv().__NemesisSkinsByConfig = getgenv().__NemesisSkinsByConfig or {}
		getgenv().__NemesisSkinsByConfig[cfgName] = data
		return wrote
	end

	getgenv().NemesisLoadSkins = function(configName)
		ensureFolder()
		local cfgName = sanitizeConfigName(configName or getgenv().__NemesisActiveConfigName or "default")
		local data = nil
		-- 1) per-config disk
		do
			local raw = tryRead(skinPathForConfig(cfgName))
			if raw then
				local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
				if ok and type(decoded) == "table" then data = decoded end
			end
		end
		-- 2) in-memory by config
		if not data and type(getgenv().__NemesisSkinsByConfig) == "table" then
			local m = getgenv().__NemesisSkinsByConfig[cfgName]
			if type(m) == "table" then data = m end
		end
		-- 3) ONLY for default config: legacy global skins.json
		if not data and cfgName == "default" then
			if type(getgenv().__NemesisSkinsForever) == "table" and type(getgenv().__NemesisSkinsForever.equip) == "table" then
				data = getgenv().__NemesisSkinsForever
			end
			if not data then
				for _, p in ipairs(PATHS) do
					local raw = tryRead(p)
					if raw then
						local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
						if ok and type(decoded) == "table" then data = decoded break end
					end
				end
			end
		end
		-- no skins for this config → empty (not previous config's skins)
		if type(data) ~= "table" then
			data = { equip = {}, fcache = {}, configName = cfgName }
		end
		if type(data.equip) ~= "table" then data.equip = {} end
		if type(data.fcache) ~= "table" then data.fcache = {} end
		data.configName = cfgName
		getgenv().NemesisSkinConfig = data
		getgenv().NemesisEquipNames = data.equip
		getgenv().NemesisFinisherNames = data.fcache
		getgenv().__NemesisSkinsForever = data
		getgenv().LionSkinState = data
		getgenv().NemesisCosmeticMirror = data
		getgenv().__NemesisSkinsByConfig = getgenv().__NemesisSkinsByConfig or {}
		getgenv().__NemesisSkinsByConfig[cfgName] = data
		getgenv().__NemesisActiveConfigName = cfgName
		-- config A skins vs config B skins: always re-apply after load
		task.defer(function()
			pcall(function()
				if getgenv().NemesisApplySavedSkins then
					getgenv().NemesisApplySavedSkins()
				end
			end)
		end)
		return next(data.equip) ~= nil
	end

	getgenv().NemesisClearSkins = function()
		local cfgName = sanitizeConfigName(getgenv().__NemesisActiveConfigName or "default")
		local empty = { equip = {}, fcache = {}, configName = cfgName }
		getgenv().NemesisSkinConfig = empty
		getgenv().NemesisEquipNames = {}
		getgenv().NemesisFinisherNames = {}
		getgenv().__NemesisSkinsForever = empty
		getgenv().LionSkinState = empty
		getgenv().NemesisCosmeticMirror = empty
		getgenv().__NemesisSkinsByConfig = getgenv().__NemesisSkinsByConfig or {}
		getgenv().__NemesisSkinsByConfig[cfgName] = empty
		-- wipe per-config file so reload stays empty
		pcall(function()
			local p = skinPathForConfig(cfgName)
			if type(writefile) == "function" then writefile(p, HttpService:JSONEncode(empty)) end
		end)
		return true
	end

	getgenv().NemesisApplySavedSkins = function()
		local data = getgenv().NemesisSkinConfig or getgenv().__NemesisSkinsForever
		if type(data) ~= "table" then
			pcall(function() if getgenv().NemesisClearSkins then getgenv().NemesisClearSkins() end end)
			return false
		end
		if type(data.equip) ~= "table" then data.equip = {} end
		-- config has no skins → keep empty (don't keep previous cfg skins)
		if next(data.equip) == nil then
			getgenv().NemesisEquipNames = {}
			getgenv().NemesisFinisherNames = type(data.fcache) == "table" and data.fcache or {}
			pcall(function()
				if getgenv().NemesisRebuildInv then getgenv().NemesisRebuildInv() end
			end)
			return false
		end
		local apply = getgenv().NemesisApplyCosmetic
		if type(apply) ~= "function" then return false end
		local applied = 0
		for weapon, row in pairs(data.equip) do
			if type(weapon) == "string" and type(row) == "table" then
				for ctype, cname in pairs(row) do
					if type(cname) == "string" and cname ~= "" then
						local ok = pcall(apply, weapon, cname, ctype, true)
						if ok then applied = applied + 1 end
					end
				end
			end
		end
		pcall(function()
			if getgenv().NemesisRebuildInv then getgenv().NemesisRebuildInv() end
		end)
		pcall(function()
			if getgenv().NemesisSafeRep then
				getgenv().NemesisSafeRep("CosmeticInventory")
				getgenv().NemesisSafeRep("WeaponInventory")
			end
		end)
		return applied > 0
	end

	pcall(getgenv().NemesisLoadSkins)
	pcall(getgenv().NemesisNormalizeConfig)

	-- re-apply several times (Delta + Rivals load order is slow)
	task.spawn(function()
		for _, waitSec in ipairs({ 1, 2, 4, 6, 10 }) do
			task.wait(waitSec)
			pcall(getgenv().NemesisLoadSkins)
			pcall(getgenv().NemesisApplySavedSkins)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(3)
			pcall(function()
				if getgenv().NemesisSerializeEquip then getgenv().NemesisSerializeEquip() end
				if getgenv().NemesisSaveSkins then getgenv().NemesisSaveSkins() end
			end)
		end
	end)

	pcall(function()
		game:GetService("Players").LocalPlayer.OnTeleport:Connect(function()
			pcall(getgenv().NemesisSaveSkins)
		end)
	end)
	pcall(function()
		game:BindToClose(function()
			pcall(getgenv().NemesisSaveSkins)
		end)
	end)

	-- hook SaveManager
	task.spawn(function()
		for _ = 1, 40 do
			task.wait(0.2)
			if SaveManager and type(SaveManager.Save) == "function" then break end
		end
		pcall(function()
			if not SaveManager or SaveManager.__NemesisHooked then return end
			SaveManager.__NemesisHooked = true
			pcall(function()
				SaveManager:SetIgnoreIndexes({ "MenuKeybind", "XCSConfig" })
			end)
			local oldSave = SaveManager.Save
			SaveManager.Save = function(self, name, ...)
				local cfgName = tostring(name or "default")
				getgenv().__NemesisActiveConfigName = cfgName
				pcall(getgenv().NemesisNormalizeConfig)
				pcall(function() getgenv().NemesisSaveSkins() end)
				pcall(function() self:BuildFolderTree() end)
				local ok, err = oldSave(self, name, ...)
				pcall(function() getgenv().NemesisSaveSkins() end)
				return ok, err
			end
			local oldLoad = SaveManager.Load
			SaveManager.Load = function(self, name, ...)
				if Library then Library.Notify = function(...) end end
				local cfgName = tostring(name or "default")
				getgenv().__NemesisActiveConfigName = cfgName
				local ok, err = oldLoad(self, name, ...)
				pcall(getgenv().NemesisNormalizeConfig)
				-- load THIS config's skins (or empty if none)
				local hasSkins = false
				pcall(function()
					hasSkins = getgenv().NemesisLoadSkins(cfgName) == true
				end)
				if not hasSkins then
					pcall(function() if getgenv().NemesisClearSkins then getgenv().NemesisClearSkins() end end)
				end
				-- apply INSTANTLY + retries (Rivals cosmetic lag)
				pcall(getgenv().NemesisApplySavedSkins)
				task.spawn(function()
					for _, w in ipairs({ 0.15, 0.4, 1.0, 2.0 }) do
						task.wait(w)
						pcall(getgenv().NemesisLoadSkins, cfgName)
						pcall(getgenv().NemesisApplySavedSkins)
					end
				end)
				return ok, err
			end
		end)
	end)
end

