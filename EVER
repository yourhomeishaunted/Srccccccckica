		Default = 1,
		Callback = function(v) aa.Yaw = v end,
	})
	box:AddSlider("NemesisAASpin", {
		Text = "Spin Speed",
		Min = 30,
		Max = 720,
		Default = 180,
		Rounding = 0,
		Callback = function(v) aa.SpinSpeed = v end,
	})
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local LP = Players.LocalPlayer
	local jitterT = 0
	pcall(function() RunService:UnbindFromRenderStep("__NemesisAA") end)
	RunService:BindToRenderStep("__NemesisAA", Enum.RenderPriority.Camera.Value + 25, function(dt)
		if not aa or not aa.Enabled then return end
		-- don't fight ragebot desync/void while rage is firing
		local cfg = getgenv().Config
		if cfg and cfg.Enabled and cfg.VoidSpam then return end
		local char = LP.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local pos = root.Position
		local cam = workspace.CurrentCamera
		local baseLook = cam and cam.CFrame.LookVector or root.CFrame.LookVector
		local flat = Vector3.new(baseLook.X, 0, baseLook.Z)
		if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
		flat = flat.Unit
		local yawCF
		if aa.Yaw == "Spin" then
			aa._spin = (aa._spin or 0) + math.rad((tonumber(aa.SpinSpeed) or 180) * (dt or 0.016))
			yawCF = CFrame.Angles(0, aa._spin, 0)
			root.CFrame = CFrame.new(pos) * yawCF
		elseif aa.Yaw == "Jitter" then
			jitterT = jitterT + (dt or 0.016)
			local j = (math.floor(jitterT * 10) % 2 == 0) and 1 or -1
			local right = Vector3.new(-flat.Z, 0, flat.X) * j
			root.CFrame = CFrame.lookAt(pos, pos + right)
		else -- Backward
			root.CFrame = CFrame.lookAt(pos, pos - flat)
		end
	end)
end)

