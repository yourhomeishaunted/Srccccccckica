	local function makeLinoriaChip(label, pos)
		-- Exact Linoria hierarchy: Outer -> Inner (inset border) -> InnerFrame (gradient) -> TextButton
		local Outer = Instance.new("Frame")
		Outer.BorderColor3 = Color3.new(0, 0, 0)
		Outer.BorderSizePixel = 0
