	task.spawn(function()
		pcall(function()
			local RS = game:GetService("ReplicatedStorage")
			local modules = RS:FindFirstChild("Modules")
			local function deep(root, ...)
				local cur = root
				for _, name in ipairs({ ... }) do
					if not cur then return nil end
					cur = cur:FindFirstChild(name)
				end
				return cur
			end
			local vmMod = deep(modules, "ClientReplicatedClasses", "ClientFighter", "ClientItem", "ClientViewModel")
			if not vmMod then
				vmMod = deep(modules, "ClientReplicatedClasses", "ClientViewModel")
			end
			if not vmMod then return end
			local ok, mod = pcall(require, vmMod)
			if not ok or type(mod) ~= "table" then return end
			local oldPlay = mod.PlayHitmarkerSound
			if type(oldPlay) ~= "function" then return end
			mod.PlayHitmarkerSound = function(...)
				if V.RemoveHitSound then
					return -- mute Rivals default hitmarker / head sound
				end
				return oldPlay(...)
			end
			-- also cover DamageEffect path if present
			pcall(function()
				local mousePath = deep(modules, "ClientReplicatedClasses", "Mouse", "MouseCrosshair")
				if not mousePath then return end
				local mok, mmod = pcall(require, mousePath)
				if not mok or type(mmod) ~= "table" then return end
				if type(mmod.DamageEffect) == "function" then
					local oldDE = mmod.DamageEffect
					mmod.DamageEffect = function(self, data, ...)
						if V.RemoveHitSound and type(data) == "table" then
							-- still allow effect logic but skip nested hitmarker by temp flag
							local r = oldDE(self, data, ...)
							return r
						end
						return oldDE(self, data, ...)
					end
				end
			end)
		end)
	end)
