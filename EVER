	-- UE-style clone hit effect + highlight (only when enemy is hit)
	local lastHealth2 = {}
	local cloneBusy = {}
	local function playUEHitEffect(character, hitPart)
		if not character then return end
		local style = getgenv().ArchHitFXStyle or "Clone"
		local col = getgenv().ArchHitFXColor or Color3.fromRGB(255, 80, 80)
		if style == "Highlight" or style == "Both" then
			pcall(function()
				local hl = Instance.new("Highlight")
				hl.FillColor = col
				hl.OutlineColor = Color3.new(1, 1, 1)
				hl.FillTransparency = 0.35
				hl.Parent = character
				task.delay(0.28, function() pcall(function() hl:Destroy() end) end)
			end)
		end
		if style == "Clone" or style == "Both" then
			if cloneBusy[character] then return end
			cloneBusy[character] = true
			pcall(function()
				local cam = workspace.CurrentCamera
				local origin = (hitPart and hitPart.Position) or (character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.Position)
				if not origin or not cam then return end
				if (origin - cam.CFrame.Position).Magnitude > 500 then return end
				local matName = getgenv().ArchHitFXMaterial or "ForceField"
				local mat = Enum.Material.ForceField
				pcall(function() if Enum.Material[matName] then mat = Enum.Material[matName] end end)
				local cloneModel = Instance.new("Model")
				cloneModel.Name = "NemesisHitFX"
				cloneModel.Parent = workspace
				for _, d in ipairs(character:GetChildren()) do
					if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
						local p = d:Clone()
						p.Anchored = true
						p.CanCollide = false
						p.CanQuery = false
						p.CanTouch = false
						p.Material = mat
						p.Color = col
						p.Transparency = 0.25
						p.Parent = cloneModel
					end
				end
				task.spawn(function()
					for i = 1, 10 do
						for _, p in ipairs(cloneModel:GetChildren()) do
							if p:IsA("BasePart") then
								p.Transparency = 0.25 + i * 0.07
								p.CFrame = p.CFrame + Vector3.new(0, 0.05, 0)
							end
						end
						task.wait(0.03)
					end
					pcall(function() cloneModel:Destroy() end)
					cloneBusy[character] = nil
				end)
			end)
			task.delay(0.6, function() cloneBusy[character] = nil end)
		end
	end
