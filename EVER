		local function autoSwitchIfEmpty(lf)
			if not getgenv().Config.AutoSwitch or not lf then return end
			pcall(function()
				local item = lf.EquippedItem
				if not item or not item.Info then return end
				local ammo = item.Info.Ammo
				local maxA = item.Info.MaxAmmo
				if ammo ~= nil and maxA ~= nil and ammo <= 0 then
					local cur = getSlotNumber()
					local nextSlot = (cur == 1) and 2 or (cur == 2) and 1 or 3
					lf:EquipItem(nextSlot)
					if nextSlot == 1 then
						getgenv().Config.PreferredWeapon = "Primary"
					elseif nextSlot == 2 then
						getgenv().Config.PreferredWeapon = "Secondary"
					end
				end
			end)
		end

		rbConn = runS.Heartbeat:Connect(function()
			if gen ~= myGen then return end
			if not getgenv().Config.Enabled then return end
			refreshFighter()
			pcall(updateDeflection)

			local cfg = getgenv().Config
			local ra = tonumber(cfg.ReadyAt) or 0
			if ra > 0 and tick() < ra then
				setHud("...")
				return
			end

			local targetPlayer, targetRoot, targetHead = getClosestTarget()
			if not targetPlayer or not targetRoot or not targetHead then
				setHud("idle...")
				return
			end
			if isInvincible(targetPlayer) then
				getgenv().__NemesisHadEnemyFF = true
				setHud("waiting " .. targetPlayer.Name .. "...")
				return
			end
			if getgenv().__NemesisHadEnemyFF then
				getgenv().__NemesisHadEnemyFF = false
				lastFire = 0
				cfg.ReadyAt = 0
			end
			if deflecting[targetPlayer] then return end
			if not lplr.Character or not lplr.Character:FindFirstChild("HumanoidRootPart") then return end
			local lf = FighterController and FighterController.LocalFighter
			if not lf then return end

			pcall(function() autoSwitchIfEmpty(lf) end)
			pcall(function() lf:EquipItem(getSlotNumber()) end)

			local myRoot = lplr.Character.HumanoidRootPart
			local oldCF = myRoot.CFrame
			local mode = tostring(cfg.AttackMode or "Gun")
			local desyncCF

			-- ===== POSITION + UE HUD (SAFE void — never killplane) =====
			local tName = targetPlayer.Name
			-- Safe void: slightly under floor, NEVER deep kill Y (-80 etc)
			local baseY = oldCF.Position.Y
			local safeVoidY = math.clamp(baseY - 14, -28, baseY - 8)
			local strength = math.clamp(tonumber(cfg.VoidStrength) or 40, 8, 55)
			-- deeper only a little with strength, still clamped safe
			local deepSafeY = math.clamp(baseY - (10 + strength * 0.15), -32, baseY - 8)
			local voidPos = Vector3.new(oldCF.Position.X, deepSafeY, oldCF.Position.Z)

			if mode == "Knife" then
				-- UE: targetHead.CFrame * CFrame.new(0, 0, 3)
				desyncCF = targetHead.CFrame * CFrame.new(0, 0, 3)
				setHud("backstabbing " .. tName .. "...")
			elseif cfg.VoidSpam then
				-- UE void: random unit * 2147483647 (not map killplane)
				desyncCF = CFrame.new(Random.new():NextUnitVector() * 2147483647)
				setHud("void spamming...")
			elseif mode == "Melee" then
				local pos = (targetRoot.CFrame * CFrame.new(0, 2.8, 0.2)).Position
				desyncCF = CFrame.lookAt(pos, targetHead.Position)
				setHud("attacking " .. tName .. "...")
			else
				local pos = (targetRoot.CFrame * CFrame.new(0, 3.0, 0.1)).Position
				desyncCF = CFrame.lookAt(pos, targetHead.Position)
				setHud("killing " .. tName .. "...")
			end

			if desyncCF then
				local oldVel, oldRot = myRoot.Velocity, myRoot.RotVelocity
				myRoot.CFrame = desyncCF
				runS:BindToRenderStep("__restore", 101, function()
					if myRoot then
						myRoot.CFrame = oldCF
						myRoot.Velocity = oldVel
						myRoot.RotVelocity = oldRot
					end
					pcall(function() runS:UnbindFromRenderStep("__restore") end)
				end)
			end

			local item = lf.EquippedItem
			if not item then
				setHud("finding weapon...")
				return
			end

			-- Force field check again before ANY fire (Gun / Knife / Melee)
			if isInvincible(targetPlayer) then
				getgenv().__NemesisHadEnemyFF = true
				setHud("waiting " .. targetPlayer.Name .. "...")
				return
			end

			local rate = tonumber(cfg.FireRate) or 0.0002
			if tick() - lastFire < rate then return end
			lastFire = tick()

			local objectId
			pcall(function() objectId = item:Get("ObjectID") end)
			if not objectId then pcall(function() objectId = item:Get("ObjectId") end) end
			if not objectId then pcall(function() objectId = item.ObjectID or item.ObjectId end) end
			if not objectId then return end

			pcall(function()
				if item.Info then
					item.Info.Ammo = item.Info.MaxAmmo or item.Info.Ammo
					item.Info.Cooldown = 0
					item.Info.ShootCooldown = 0
					item.Info.AttackCooldown = 0
					item.Info.FireRate = 0
					pcall(function() item.Info.Reloading = false end)
				end
			end)

			local originPos = desyncCF and desyncCF.Position or myRoot.Position
			local aimCF = CFrame.lookAt(originPos, targetHead.Position)
			local headOffset = targetHead.CFrame:ToObjectSpace(CFrame.new(targetHead.Position))
			local cameradata = {
				[utf8.char(1)] = {
					[utf8.char(0)] = util:EncodeCFrame(aimCF),
					[utf8.char(1)] = util:EncodeCFrame(targetHead.CFrame),
					[utf8.char(2)] = targetHead,
					[utf8.char(3)] = util:EncodeCFrame(headOffset),
				}
			}

			local remote = repS.Remotes.Replication.Fighter.UseItem
			local shot = enum:ToEnum("StartShooting")
			local aim = enum:ToEnum("StartAiming")
			local bursts = math.clamp(tonumber(cfg.ShootAttempts) or 16, 6, 28)

			if mode == "Knife" then
				-- ===== UE ragebot_backstab_target exact =====
				voidSpamValue = cfg.VoidSpam or false
				voidSpamHideValue = tonumber(cfg.VoidHide) or 0.25

				-- UE: targetPart = HitboxHead — resolve it directly from the target character
				local targetChar = targetPlayer and targetPlayer.Character
				local targetPart = targetChar and (
					targetChar:FindFirstChild("HitboxHead")
					or targetChar:FindFirstChild("PhysicalHitboxHead")
					or targetChar:FindFirstChild("HitboxHeadSmall")
					or targetChar:FindFirstChild("Head")
				)

				-- UE: equip check
				if lf.EquippedItem ~= item then
					task.spawn(lf.EquipItem, lf, item.Data.ItemIndex)
					pcall(function() myRoot.CFrame = selectedAttackResolver() end)
					setHud("void...")
					return
				end
				if not targetPart then
					pcall(function() myRoot.CFrame = selectedAttackResolver() end)
					setHud("void...")
					return
				end

				local currentTime = tick()

				-- UE: new target resets cooldown window
				if targetPart ~= knifeLastTarget and knifeAttackReadyAt < currentTime then
					knifeLastTarget = targetPart
					knifeAttackReadyAt = currentTime + workerInterval
				end

				local targetPosition = targetPart.Position

				-- UE: shield-aware aimTransform (shieldOffset = 5 or -5 for knife)
				local aimTransform
				local hasShield, shieldSide = false, false
				pcall(function()
					for _, fo in FighterController.Objects do
						if fo.Player == targetPlayer then
							local eq = fo.EquippedItem
							if eq and eq.ViewModel and eq.ViewModel.Name == "Riot Shield" then
								hasShield = true
								shieldSide = fo.Root.CFrame.RightVector:Dot(
									(myRoot.Position - fo.Root.Position).Unit
								) > 0
							end
							break
						end
					end
				end)
				if hasShield then
					local shieldOffset = shieldSide and 5 or -5
					local entityRotation = CFrame.identity
					pcall(function() entityRotation = targetRoot.CFrame - targetRoot.CFrame.Position end)
					aimTransform = CFrame.new(targetPosition) * entityRotation * CFrame.new(0, 0, shieldOffset)
				else
					-- UE: neutralDependency9(targetPosition) + Random.new():NextUnitVector() * 5
					aimTransform = CFrame.new(targetPosition + Random.new():NextUnitVector() * 5)
				end
				-- UE: encodedAimPosition = CFrame.new(aimTransform.Position, targetPosition)
				local encodedAimPosition = CFrame.new(aimTransform.Position, targetPosition)

				-- UE: attackTransform = targetPart.CFrame * CFrame.new(0, 0, 3)
				local attackTransform = targetPart.CFrame * CFrame.new(0, 0, 3)

				local oid
				pcall(function() oid = item:Get("ObjectID") end)

				if knifeAttackReadyAt < currentTime then
					-- UE: HeavyAttack cycling
					if not item._heavy_attack_num then item._heavy_attack_num = 0 end
					item._heavy_attack_num = item._heavy_attack_num % #item.ViewModel:GetAnimationKeys("HeavyAttack") + 1
					local attackAnimation = "HeavyAttack" .. item._heavy_attack_num
					-- UE: encodedPosition exact packet
					local encodedPosition = {
						["\0"] = util:EncodeCFrame(attackTransform),
						["\1"] = util:EncodeCFrame(attackTransform + Vector3.one * 0.01),
						["\2"] = targetPart,
						["\3"] = util:EncodeCFrame(CFrame.new(math.random()*0.1, math.random()*0.1, math.random()*0.1)),
					}
					local encodedArguments = {
						["\1"] = encodedPosition,
						["\2"] = enum:ToEnum(attackAnimation),
					}
					-- UE: FireServer(ObjectID, StartAiming, encodedArguments, nil)
					if oid then
						pcall(function()
							remote:FireServer(oid, enum:ToEnum("StartAiming"), encodedArguments, nil)
						end)
					end
					-- UE: knifeAttackReadyAt = tick() + item.Info.HeavyAttackCooldown * 0.75
					knifeAttackReadyAt = tick() + item.Info.HeavyAttackCooldown * 0.75
					-- UE: snapshotP566Capture2(selectedAttackResolver())
					pcall(function() myRoot.CFrame = selectedAttackResolver() end)
					setHud("backstabbing " .. targetPlayer.Name .. "...")

				elseif knifeAttackReadyAt < currentTime + math.max(1/60, voidSpamDelay) then
					-- UE: snapshotP566Capture2(encodedAimPosition * CFrame.Angles(0, random()/10, 0))
					-- UE: neutralDependency18(attackTransform, true) — set aim visually
					pcall(function()
						myRoot.CFrame = encodedAimPosition * CFrame.Angles(0, math.random()/10, 0)
					end)
					setHud("backstabbing " .. targetPlayer.Name .. "...")

				else
					-- UE: snapshotP566Capture2(selectedAttackResolver())
					pcall(function() myRoot.CFrame = selectedAttackResolver() end)
					setHud("stabbing " .. targetPlayer.Name .. " in " ..
						string.format("%.2f", knifeAttackReadyAt - tick() - voidSpamDelay) .. "... (void)")
				end
			elseif mode == "Melee" then
				local meleeData = {
					[utf8.char(1)] = cameradata[utf8.char(1)],
					[utf8.char(2)] = aim,
				}
				pcall(function() remote:FireServer(objectId, aim, meleeData, nil) end)
				for _ = 1, math.min(bursts, 8) do
					pcall(function() remote:FireServer(objectId, shot, cameradata, nil) end)
				end
			else
				pcall(function() remote:FireServer(objectId, aim, cameradata, nil) end)
				for _ = 1, bursts do
					pcall(function() remote:FireServer(objectId, shot, cameradata, nil) end)
				end
			end

			-- UE void extra shot
			if cfg.VoidSpam then
				task.defer(function()
					pcall(function()
						local realCam = workspace.CurrentCamera.CFrame
						remote:FireServer(objectId, shot, cameradata, nil)
						task.wait()
						pcall(function() workspace.CurrentCamera.CFrame = realCam end)
					end)
				end)
			end
		end)
	end)

	if not ok then
		pcall(function()
			if Library then Library:Notify("Ragebot: " .. tostring(err)) end
		end)
		stopRagebot()
	end
end

