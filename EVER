local function setRageHud(msg)
	-- disabled → hide on-screen HUD completely
	if not (getgenv().Config and getgenv().Config.Enabled) then
		hideRageHudScreen()
		return
	end
	local text = msg
	-- UE-style HUD: pass through stabbing / void / killing / attacking text as-is
	if not text or text == "" or text == "ragebot: idle" or text == "idle..." then
		text = "idle..."
	elseif text:find("stabbing", 1, true) or text:find("void", 1, true)
		or text:find("killing", 1, true) or text:find("attacking", 1, true)
		or text:find("waiting", 1, true) or text:find("finding", 1, true)
		or text:find("...", 1, true) then
		-- keep UE message
	else
		local user = text:match("@(.+)$")
		if text:find("ragebot:", 1, true) then
			-- keep
		else
			text = formatRageHud("active", user or text)
		end
	end

getgenv().NemesisSetRageHud = setRageHud
	if RageHudLabel then
		pcall(function()
