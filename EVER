				if not root then return end
				origin = root.Position
			end
			local barriers = barriersFolder:GetChildren()
			if #barriers == 0 then return end
			local candidatePositions = {}
			for _, direction in unitDirections do
				local activeBarriers = table.clone(barriers)
				local rp = RaycastParams.new()
				rp.FilterDescendantsInstances = activeBarriers
				rp.FilterType = Enum.RaycastFilterType.Whitelist
				rp.BruteForceAllSlow = true
				local scaledDir = direction * 500
				local hit = workspace:Raycast(origin, scaledDir, rp)
				while true do
					rp.FilterDescendantsInstances = activeBarriers
					local castOrigin = hit and hit.Position or (origin + scaledDir)
					local nextHit = workspace:Raycast(castOrigin, origin - castOrigin, rp)
					if nextHit then
						hit = nextHit
						table.remove(activeBarriers, table.find(activeBarriers, hit.Instance))
					else
						if hit then table.insert(candidatePositions, hit.Position - direction * 10) end
						break
					end
				end
			end
			return candidatePositions
		end
		local function ragebot_resolve_current_attack()
			local currentDuel
			pcall(function() currentDuel = SpectateController and SpectateController.CurrentDuelSubject end)
			if currentDuel then
				local rec = attackCache[currentDuel]
				if not rec then
					local positions = ragebot_compute_map_positions(currentDuel)
					if positions and #positions > 0 then
						attackCache[currentDuel] = { positions, #positions }
					end
				end
				local r = attackCache[currentDuel]
				if r then return CFrame.new(r[1][math.random(1, r[2])]) end
			end
			-- team mode fallback
			local enemyPositions = {}
			pcall(function()
				for _, fo in FighterController.Objects do
					if fo.Player and fo.Player.Team ~= lplr.Team and fo.Root then
						table.insert(enemyPositions, fo.Root.Position)
					end
				end
			end)
			if #enemyPositions > 0 then
				return CFrame.new(enemyPositions[math.random(1, #enemyPositions)])
			end
			return CFrame.new(Random.new():NextUnitVector() * 2147483647)
		end
		local ok_c, _c = pcall(function()
			return require(repS:WaitForChild("Modules", 5):WaitForChild("CONSTANTS", 5))
		end)
		if (ok_c and _c and _c.IS_PRIVATE_SERVER) or game.PlaceId ~= 17625359962 then
			selectedAttackResolver = function() return CFrame.new(Random.new():NextUnitVector() * 2147483647) end
		else
			selectedAttackResolver = ragebot_resolve_current_attack
		end

		-- UE void spam timing state
		local voidSpamDelay = 0.05
