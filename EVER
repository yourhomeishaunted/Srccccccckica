	end

	-- UE-style part apply
	local function applyUEPart(part, opts)
		if not part or not part:IsA("BasePart") then return end
		pcall(function()
			if opts.color then
				part.Color = opts.color
			end
			if opts.material then
				part.Material = opts.material
			end
			if opts.transparency ~= nil then
				part.Transparency = opts.transparency
			end
			if opts.wireframe then
				-- UE wireframe: force neon thin look
				part.Material = Enum.Material.ForceField
				if part:IsA("MeshPart") then
					pcall(function() part.TextureID = "" end)
				end
			end
			if opts.textures then
				if part:IsA("MeshPart") then
					pcall(function() part.TextureID = "" end)
				end
				for _, d in ipairs(part:GetChildren()) do
					if d:IsA("Decal") or d:IsA("Texture") then
						pcall(function() d.Transparency = 1 end)
					end
				end
			end
		end)
	end

	local function matEnum(name)
		local ok, m = pcall(function() return Enum.Material[name] end)
		return ok and m or Enum.Material.ForceField
	end

	local function refreshViewmodel()
		local root = getVMRoot()
		if not root then return end

		local bodyOpts, armOpts = nil, nil
		if V.Appearance then
			bodyOpts = {
				transparency = 1 - (tonumber(V.Transparency) or 1),
				color = V.BodyColorEnabled and V.Color or nil,
				material = V.MaterialEnabled and matEnum(V.Material) or nil,
				textures = V.DisableTextures == true,
				wireframe = V.Wireframe == true,
			}
			-- UE: transparency slider is 0-100%, stored as 0-1 fraction of *visible* inverse
			-- V.Transparency 1 means fully opaque appearance override strength like UE 100%
			bodyOpts.transparency = math.clamp(1 - (tonumber(V.Transparency) or 1), 0, 1)
		end
		if V.ArmAppearance then
			armOpts = {
				transparency = math.clamp(1 - (tonumber(V.ArmTransparency) or 1), 0, 1),
				color = V.ArmColorEnabled and V.ArmColor or nil,
				material = V.ArmMaterialEnabled and matEnum(V.ArmMaterial) or nil,
				textures = V.ArmDisableClothes == true,
				wireframe = V.Wireframe == true,
			}
		end

		local function handle(inst)
			for _, d in ipairs(inst:GetDescendants()) do
				if d:IsA("BasePart") then
					local arm = isArm(d.Name) or isArm(d.Parent and d.Parent.Name)
					if arm and armOpts then
						applyUEPart(d, armOpts)
					elseif (not arm) and bodyOpts then
						applyUEPart(d, bodyOpts)
					end
				elseif V.ArmAppearance and V.ArmDisableClothes and (d:IsA("Clothing") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic")) then
					pcall(function() d:Destroy() end)
				elseif bodyOpts and bodyOpts.textures and (d:IsA("Decal") or d:IsA("Texture")) then
					pcall(function() d.Transparency = 1 end)
				end
			end
			if V.Offset and inst:IsA("Model") then
				pcall(function()
					local off = CFrame.new(V.OX or 0, V.OY or 0, V.OZ or 0)
						* CFrame.Angles(math.rad(V.Pitch or 0), math.rad(V.Yaw or 0), math.rad(V.Roll or 0))
					if inst.PrimaryPart then
						inst:SetPrimaryPartCFrame(inst.PrimaryPart.CFrame * off)
					end
				end)
			end
		end

		if root == Workspace:FindFirstChild("ViewModels") or (root.Parent == Workspace) then
			for _, model in ipairs(root:GetChildren()) do
				handle(model)
			end
		else
			handle(root)
		end

		if V.OverrideFPS and setfpscap then
			pcall(setfpscap, V.FPS)
		end
	end

